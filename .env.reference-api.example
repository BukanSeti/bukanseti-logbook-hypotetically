# SERVER ONLY. Never send this file or its values to repo users.
LION_AIR_CREW_SHEET_ID=
LION_AIR_AIRCRAFT_SHEET_ID=

# Choose one credential source.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# JSON map: user label -> SHA-256 hash of that user's token.
# Generate a token with: python scripts/generate_reference_token.py friend-name
CORADINE_API_TOKEN_HASHES={}

CORADINE_API_RATE_LIMIT_PER_MINUTE=60
CORADINE_REFERENCE_CACHE_TTL_SECONDS=300
CORADINE_API_DOCS=false
