# Required only for photo/PDF AI extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Private lookup API supplied by the system owner.
# The client receives only:
# - crew: employee_id + full_name
# - aircraft: registration + aircraft_type
CORADINE_REFERENCE_API_URL=
CORADINE_REFERENCE_API_TOKEN=

# Administrator-only local fallback. Keep disabled for shared copies.
CORADINE_ALLOW_LOCAL_REFERENCE_ADMIN=false
LION_AIR_CREW_XLSX=.cache/Lion_Air_Crew.xlsx
LION_AIR_AIRCRAFT_XLSX=.cache/Lion_Air_Airplane.xlsx
